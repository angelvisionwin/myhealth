{
  "id": "/",
  "name": "MyHealth",
  "short_name": "MyHealth",
  "description": "Entrenamientos de Hevy y medidas corporales en un solo lugar.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f8fb",
  "theme_color": "#206bc4",
  "categories": ["health", "fitness"],
  "icons": [
    {
      "src": "/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/images/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuevo registro",
      "short_name": "Registro",
      "url": "/measurements/new",
      "icons": [{ "src": "/images/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sincronizar Hevy",
      "short_name": "Sincronizar",
      "url": "/workouts/sync",
      "icons": [{ "src": "/images/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
