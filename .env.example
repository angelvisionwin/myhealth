PORT=3000
HOST=127.0.0.1
APP_TIMEZONE=Europe/Madrid
DATABASE_PATH=data/myhealth.db

# Clave de la API de Hevy (https://hevy.com/settings?developer).
# No la incluyas en Git ni la muestres en capturas.
HEVY_API_KEY=

# Entrenador: capa opcional de IA para redactar informes (desactivada por defecto).
# Sin estas variables el entrenador funciona igual con el motor de reglas.
COACH_LLM_ENABLED=false
COACH_LLM_BASE_URL=https://api.openai.com/v1
COACH_LLM_API_KEY=
COACH_LLM_MODEL=
