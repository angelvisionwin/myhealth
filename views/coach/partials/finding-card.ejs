<%
  const severity = fmt.findingSeverity(finding.severity);
%>
<div class="card mb-2">
  <div class="card-body py-3">
    <div class="d-flex align-items-start gap-3">
      <span class="badge <%= severity.className %> flex-shrink-0"><%= severity.label %></span>
      <div class="flex-fill min-w-0">
        <div class="fw-semibold"><%= finding.title %></div>
        <p class="text-secondary mb-1"><%= finding.detail %></p>

        <% if (finding.evidence && finding.evidence.length > 0) { %>
          <ul class="small text-secondary mb-1 ps-3">
            <% finding.evidence.forEach((item) => { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <% if (finding.action) { %>
          <div class="small">
            <span class="fw-semibold">Acción:</span>
            <span><%= finding.action %></span>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
