<% if (statusMessage) { %>
  <div class="alert alert-<%= statusMessage.type %>" role="alert">
    <div class="fw-semibold"><%= statusMessage.title %></div>
    <p class="mb-0"><%= statusMessage.message %></p>
  </div>
<% } %>

<div class="alert alert-info" role="alert">
  <div class="fw-semibold">Copia de solo lectura</div>
  <p class="mb-0 small">
    Para modificar esta rutina, edítala en Hevy y pulsa «Sincronizar rutinas» en
    <a href="/coach/routines">Rutinas</a>. Los ejercicios se muestran en español cuando existe
    una traducción registrada en tus entrenamientos.
  </p>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
  <div>
    <div class="text-secondary small">
      <% if (folder) { %>Carpeta «<%= folder.title %>» · <% } %>
      <% if (routine.syncedAt) { %>Sincronizada el <%= fmt.dateTime(routine.syncedAt) %><% } %>
    </div>
    <h3 class="mb-1"><%= routine.title %></h3>
    <div class="text-secondary small">
      <%= exercises.length %> ejercicio<%= exercises.length === 1 ? '' : 's' %> ·
      <%= totalSets %> serie<%= totalSets === 1 ? '' : 's' %>
    </div>
  </div>
  <div class="btn-list">
    <a class="btn btn-sm btn-outline-secondary" href="/coach/routines">Volver a rutinas</a>
    <a class="btn btn-sm btn-outline-primary" href="/coach/plan">Ver plan semanal</a>
  </div>
</div>

<% if (exercises.length === 0) { %>
  <div class="alert alert-info" role="alert">
    Esta rutina no tiene ejercicios guardados. Sincroniza de nuevo desde Hevy.
  </div>
<% } %>

<% exercises.forEach((exercise) => { %>
  <div class="card mb-3">
    <div class="card-header">
      <div>
        <h3 class="card-title mb-1"><%= exercise.displayName %></h3>
        <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small">
          <% if (exercise.groupLabel) { %>
            <span class="badge bg-blue-lt"><%= exercise.groupLabel %></span>
          <% } %>
          <% if (exercise.supersetId !== null) { %>
            <span class="badge bg-purple-lt">Superserie</span>
          <% } %>
          <% if (exercise.isUnilateral) { %>
            <span class="badge bg-cyan-lt">Por lado</span>
          <% } %>
          <% if (exercise.restSeconds) { %>
            <span>Descanso: <%= fmt.duration(exercise.restSeconds) %></span>
          <% } %>
        </div>
      </div>
      <div class="card-actions text-secondary small">
        <%= exercise.workingSetCount %> serie<%= exercise.workingSetCount === 1 ? '' : 's' %> de trabajo
        <% if (exercise.warmupSetCount > 0) { %>
          · <%= exercise.warmupSetCount %> de calentamiento
        <% } %>
      </div>
    </div>
    <div class="card-body">
      <% if (exercise.notes) { %>
        <p class="text-secondary small"><%= exercise.notes %></p>
      <% } %>

      <% if (exercise.sets.length === 0) { %>
        <div class="text-secondary small">Sin series registradas.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-sm card-table table-vcenter mb-0">
            <thead>
              <tr>
                <th>Serie</th>
                <th>Tipo</th>
                <th>Peso</th>
                <th>Reps</th>
                <th>Duración</th>
                <th>Distancia</th>
              </tr>
            </thead>
            <tbody>
              <% exercise.sets.forEach((set) => { %>
                <tr>
                  <td><%= set.index %></td>
                  <td><%= fmt.setType(set.type) %></td>
                  <td>
                    <% if (set.weightKg !== null && set.weightKg > 0) { %>
                      <%= fmt.number(set.weightKg) %> kg<%= exercise.isUnilateral ? ' por lado' : '' %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td>
                    <% if (set.repRange) { %>
                      <%= set.repRange.start %>–<%= set.repRange.end %>
                    <% } else if (set.reps !== null && set.reps > 0) { %>
                      <%= set.reps %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td>
                    <% if (set.durationSeconds && set.durationSeconds > 0) { %>
                      <%= fmt.duration(set.durationSeconds) %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                  <td>
                    <% if (set.distanceMeters && set.distanceMeters > 0) { %>
                      <% if (set.distanceMeters >= 1000) { %>
                        <%= fmt.number(set.distanceMeters / 1000) %> km
                      <% } else { %>
                        <%= fmt.number(set.distanceMeters) %> m
                      <% } %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
<% }); %>
