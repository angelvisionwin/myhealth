<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
  <p class="text-secondary mb-0">
    Cada informe guarda una foto del análisis, así puedes comparar cómo cambia el consejo.
  </p>
  <form method="post" action="/coach/reports">
    <button class="btn btn-primary" type="submit">Generar informe</button>
  </form>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table card-table table-vcenter">
      <thead>
        <tr>
          <th>Informe</th>
          <th>Periodo</th>
          <th>Generado</th>
          <th>Reglas</th>
          <th>IA</th>
          <th class="text-end">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if (reports.length === 0) { %>
          <tr>
            <td colspan="6" class="text-secondary">
              Todavía no hay informes. Genera el primero para empezar el seguimiento.
            </td>
          </tr>
        <% } %>
        <% reports.forEach((report) => { %>
          <tr>
            <td class="fw-semibold">#<%= report.id %></td>
            <td><%= fmt.date(report.period_start) %> – <%= fmt.date(report.period_end) %></td>
            <td><%= fmt.dateTime(report.generated_at) %></td>
            <td><span class="text-secondary">v<%= report.rules_version %></span></td>
            <td>
              <% if (report.ai_text) { %>
                <span class="badge bg-purple-lt" title="<%= report.ai_model %>">Redactado</span>
              <% } else { %>
                <span class="text-secondary">—</span>
              <% } %>
            </td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-secondary" href="/coach/reports/<%= report.id %>">
                Ver
              </a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
