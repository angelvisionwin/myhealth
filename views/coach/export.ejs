<% if (statusMessage) { %>
  <div class="alert alert-<%= statusMessage.type %>" role="alert">
    <div class="fw-semibold"><%= statusMessage.title %></div>
    <p class="mb-0"><%= statusMessage.message %></p>
  </div>
<% } %>

<div class="row row-cards">
  <div class="col-lg-7">
    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title">
          <%- include('../partials/icon', { name: 'download', size: 20, className: 'me-1' }) %>
          Exportar datos
        </h3>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          Descarga una copia legible de tus datos. El JSON incluye todas las tablas; los CSV son
          cómodos para abrir en una hoja de cálculo.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a class="btn btn-primary" href="/coach/export.json">Descargar JSON completo</a>
          <a class="btn btn-outline-secondary" href="/coach/export.csv?type=measurements">
            Medidas CSV
          </a>
          <a class="btn btn-outline-secondary" href="/coach/export.csv?type=checkins">
            Check-ins CSV
          </a>
          <a class="btn btn-outline-secondary" href="/coach/export.csv?type=hiking">
            Montaña CSV
          </a>
        </div>
        <div class="text-secondary small mt-3">
          Los archivos CSV usan punto y coma y BOM UTF-8 para abrirse bien en Excel en español.
        </div>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <h3 class="card-title">Copia consistente de la base de datos</h3>
      </div>
      <div class="card-body">
        <p class="text-secondary small">
          La copia usa el mecanismo de SQLite para no dejar el archivo a medias aunque haya
          escrituras en curso. Se guarda en <code>data/backups</code>, fuera de la carpeta pública.
        </p>
        <form method="post" action="/coach/backup">
          <button class="btn btn-outline-primary" type="submit">Crear copia ahora</button>
        </form>
        <div class="text-secondary small mt-3">
          Para restaurar: para el servidor, sustituye <code>data/myhealth.db</code> por la copia y
          arranca de nuevo. Guarda una copia fuera del equipo de vez en cuando.
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Copias guardadas</h3>
        <div class="card-actions text-secondary small"><%= backups.length %></div>
      </div>
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Archivo</th>
              <th>Fecha</th>
              <th class="text-end">Tamaño</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (backups.length === 0) { %>
              <tr>
                <td colspan="4" class="text-secondary">Todavía no hay copias guardadas.</td>
              </tr>
            <% } %>
            <% backups.forEach((backup) => { %>
              <tr>
                <td class="small"><%= backup.file %></td>
                <td class="small"><%= fmt.dateTime(backup.createdAt) %></td>
                <td class="text-end small"><%= fmt.number(Math.round(backup.sizeBytes / 1024)) %> KB</td>
                <td class="text-end">
                  <a class="btn btn-sm btn-ghost-secondary" href="/coach/backup/<%= backup.file %>">
                    Descargar
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Contenido</h3>
      </div>
      <div class="table-responsive">
        <table class="table card-table table-vcenter">
          <thead>
            <tr>
              <th>Tabla</th>
              <th class="text-end">Registros</th>
            </tr>
          </thead>
          <tbody>
            <% tables.forEach((table) => { %>
              <tr>
                <td><%= table.label %></td>
                <td class="text-end"><%= fmt.number(table.count) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
