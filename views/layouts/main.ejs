<!doctype html>
<html lang="es" data-bs-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="MyHealth: entrenamientos de Hevy y medidas corporales en local.">
    <title><%= pageTitle ? `${pageTitle} · ${appName}` : appName %></title>

    <meta name="theme-color" content="#206bc4">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="MyHealth">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    <link rel="apple-touch-icon" href="/images/icons/apple-touch-icon.png">
    <link rel="stylesheet" href="/vendor/tabler/css/tabler.min.css">
    <link rel="stylesheet" href="/css/app.css">

    <script>
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem('myhealth-theme');
        } catch (error) {
          // Sin preferencia guardada se usará la del sistema.
        }

        if (theme !== 'light' && theme !== 'dark') {
          theme =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        }

        document.documentElement.setAttribute('data-bs-theme', theme);
      })();
    </script>
  </head>
  <body class="layout-fluid">
    <div class="page">
      <%- include('../partials/sidebar') %>

      <div class="page-wrapper">
        <%- include('../partials/topbar') %>

        <div class="page-body">
          <div class="container-xl">
            <%- body %>
          </div>
        </div>

        <%- include('../partials/footer') %>
      </div>
    </div>

    <script src="/vendor/tabler/js/tabler.min.js"></script>
    <script src="/js/app.js"></script>
    <% if (typeof pageScripts !== 'undefined' && Array.isArray(pageScripts)) { %>
      <% pageScripts.forEach((script) => { %>
        <script src="<%= script %>"></script>
      <% }); %>
    <% } %>
  </body>
</html>
